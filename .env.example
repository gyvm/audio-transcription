# OpenAI API Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here

# AmiVoice API Configuration
VITE_AMIVOICE_API_KEY=your_amivoice_api_key_here

# Google Speech-to-Text API Configuration
VITE_GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here

# Firebase Configuration (Required for Google Speech long audio processing)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Application Configuration
VITE_APP_NAME=音声文字起こしサービス
VITE_MAX_FILE_SIZE_MB=10
VITE_MAX_DURATION_MINUTES=10

# Development Configuration
VITE_DEV_MODE=true